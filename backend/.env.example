# Copie este arquivo para .env e preencha SECRET_KEY. Nunca envie o .env para o GitHub.
# Use apenas letras e números na senha (símbolos como @ # / quebram a URL do banco).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=praticao123
POSTGRES_DB=praticao

# Chave que assina os tokens de login (JWT). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Recuperação de senha em modo demonstração (1 = a API devolve o token na resposta, sem enviar e-mail;
# 0 = não devolve). Em uso real, deixe 0 e envie o link por e-mail.
RECUPERACAO_DEMO=1
